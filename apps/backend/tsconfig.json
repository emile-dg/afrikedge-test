{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "sourceMap": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
